# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# playwright / e2e
/test-results/
/playwright-report/
/playwright/.cache/
/e2e/.auth/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.worktrees/

# claude code local worktrees (embedded git repos — must never be committed)
.claude/worktrees/

# claude code local settings (machine-specific permissions)
.claude/settings.local.json

# security review notes — kept local by policy. This repo is public, and a
# commit here cannot be retracted: GitHub's public event stream is mirrored by
# third-party archives within minutes, so a later `git rm` does not recall it.
docs/security-review-*.md
