{
  "name": "care-book",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test:unit": "npm run test:e2e:support && node --test --experimental-strip-types $(find src/lib -name '*.test.ts' -print)",
    "test:e2e:support": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test --experimental-strip-types e2e/support/clinic-date.test.ts e2e/support/factories.test.ts e2e/support/route-manifest.test.ts e2e/support/supabase-admin.test.ts",
    "test:component": "vitest run",
    "test:integration": "node --test --experimental-strip-types $(find test/integration -name '*.test.ts' -print)",
    "build:e2e": "dotenv -e .env.e2e -o -- next build",
    "start:e2e": "dotenv -e .env.e2e -o -- next start",
    "e2e:seed": "dotenv -e .env.e2e -o -- node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types e2e/support/seed-cli.ts",
    "pretest:e2e": "npm run e2e:db:up && npm run e2e:seed",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e/tsconfig.json",
    "e2e:db:up": "supabase start",
    "e2e:db:reset": "supabase db reset",
    "e2e:db:down": "supabase stop",
    "prepare": "husky"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.97.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "lucide-react": "^0.575.0",
    "next": "^16.2.10",
    "react": "^18",
    "react-day-picker": "^9.13.2",
    "react-dom": "^18",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.10",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.10",
    "supabase": "^2.109.1",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "postcss": "^8.5.10"
  }
}
