# E2E environment — points the app + seed harness at the LOCAL Supabase stack
# (`supabase start`). These are Supabase's well-known fixed local-development keys:
# they are NOT secret and only work against a localhost stack, so this file is
# committed on purpose to give CI and every developer a zero-config E2E backend.
# Never put a real/hosted project's keys here.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# Canonical origin used for auth email redirect links (kept local for E2E).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Platform super-admin allowlist — includes the console account and isolated sign-out identity.
PLATFORM_ADMIN_EMAILS=platform-admin@carebook.test,platform-signout@carebook.test

# Cron endpoint shared secret (arbitrary for E2E).
CRON_SECRET=e2e-cron-secret
