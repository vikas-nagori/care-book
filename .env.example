# Copy to .env.local and fill in for local development against a real Supabase project.
# (E2E tests do NOT use this file — they use the committed .env.e2e against a local stack.)

# Supabase project (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-public-key>
# Service-role key — server-only, bypasses RLS. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Canonical app origin (production URL). Used to build auth email redirect links
# so they never point at localhost.
NEXT_PUBLIC_SITE_URL=https://your-app.example.com

# Comma-separated emails allowed into the /platform super-admin console.
PLATFORM_ADMIN_EMAILS=you@example.com

# Shared secret for the appointment auto-complete cron endpoint.
CRON_SECRET=<random-string>
